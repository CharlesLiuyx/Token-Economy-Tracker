<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<title>TOKEN ECONOMY TRACKER</title>
<script>
/* 首帧前设定偏好，防闪：localStorage 覆盖 > 缺省（浅色 / 加宽 / 中字号 / 术语开；
   语言缺省 zh，浏览器非中文则 en） */
(function () {
  var root = document.documentElement, ls = {};
  try { ls = localStorage; } catch (e) {}
  function pick(key, allowed, dflt) {
    var v = null;
    try { v = ls.getItem(key); } catch (e) {}
    return allowed.indexOf(v) >= 0 ? v : dflt;
  }
  root.dataset.theme = pick("theme", ["light", "dark"], "light");
  root.dataset.width = pick("width", ["normal", "wide", "full"], "wide");
  root.dataset.fs = pick("fs", ["s", "m", "l"], "m");
  root.dataset.terms = pick("terms", ["on", "off"], "on");
  var l = pick("lang", ["zh", "en"], /^zh/i.test(navigator.language || "") ? "zh" : "en");
  root.dataset.lang = l;
  if (l === "en") root.lang = "en";
})();
</script>
<style>
{{ style }}
</style>
</head>
<body>

<header class="topbar" id="topbar">
  <a class="brand" href="#top">TOKEN ECONOMY TRACKER</a>
  <nav class="topnav">
    <a href="#sec-brief" data-i18n="sec.brief.title">{{ t('sec.brief.title') | e }}</a>
    <a href="#sec-arr">ARR</a>
    <a href="#sec-tokens">Tokens</a>
    <a href="#sec-gpu">GPU</a>
    <a href="#sec-dc">Datacenters</a>
    <a href="#sec-methodology">Methodology</a>
    <a id="nav-models" class="nav-ext" href="llm-release-bench/" data-i18n="ui.nav_models"
       data-i18n-tip="ui.nav_models_tip">{{ t('ui.nav_models') | e }}</a>
  </nav>
  <span class="spacer"></span>
  <button id="back-btn" class="tb-btn" type="button" hidden
          data-i18n="ui.back" data-i18n-args='{"n": 0}'>{{ t('ui.back', n=0) | e }}</button>
  <span class="build-ts">BUILD {{ build_ts }}</span>
  <button id="lang-btn" class="tb-btn" type="button" data-i18n-tip="ui.lang_tip"><span class="when-zh">EN</span><span class="when-en">中文</span></button>
  <button id="theme-btn" class="tb-btn" type="button" data-i18n-tip="ui.theme_tip"><span class="when-light" data-i18n="ui.theme.dark">{{ t('ui.theme.dark') | e }}</span><span class="when-dark" data-i18n="ui.theme.light">{{ t('ui.theme.light') | e }}</span></button>
  <a class="tb-btn tb-link" href="https://github.com/CharlesLiuyx/Token-Economy-Tracker"
     target="_blank" rel="noopener noreferrer" data-i18n-tip="ui.github">GitHub ↗</a>
  <div class="more">
    <button id="more-btn" class="tb-btn" type="button" aria-haspopup="true" aria-expanded="false"
            data-i18n="ui.more">{{ t('ui.more') | e }}</button>
    <div id="more-menu" class="more-menu" hidden>
      <div class="menu-row"><span data-i18n="ui.width">{{ t('ui.width') | e }}</span>
        <div class="seg" data-pref="width">
          <button type="button" data-v="normal" data-i18n="ui.width.normal">{{ t('ui.width.normal') | e }}</button>
          <button type="button" data-v="wide" data-i18n="ui.width.wide">{{ t('ui.width.wide') | e }}</button>
          <button type="button" data-v="full" data-i18n="ui.width.full">{{ t('ui.width.full') | e }}</button>
        </div></div>
      <div class="menu-row"><span data-i18n="ui.fs">{{ t('ui.fs') | e }}</span>
        <div class="seg" data-pref="fs">
          <button type="button" data-v="s" data-i18n="ui.fs.s">{{ t('ui.fs.s') | e }}</button>
          <button type="button" data-v="m" data-i18n="ui.fs.m">{{ t('ui.fs.m') | e }}</button>
          <button type="button" data-v="l" data-i18n="ui.fs.l">{{ t('ui.fs.l') | e }}</button>
        </div></div>
      <div class="menu-row"><span data-i18n="ui.terms">{{ t('ui.terms') | e }}</span>
        <div class="seg" data-pref="terms">
          <button type="button" data-v="on" data-i18n="ui.on">{{ t('ui.on') | e }}</button>
          <button type="button" data-v="off" data-i18n="ui.off">{{ t('ui.off') | e }}</button>
        </div></div>
    </div>
  </div>
</header>

<aside id="toc" data-fig-key="ui.fig" data-tbl-key="ui.tbl">
  <div class="toc-tabs">
    <button type="button" id="toc-tab-ch" aria-pressed="true" data-i18n="ui.toc.chapters">{{ t('ui.toc.chapters') | e }}</button>
    <button type="button" id="toc-tab-as" aria-pressed="false" data-i18n="ui.toc.assets">{{ t('ui.toc.assets') | e }}</button>
    <button type="button" id="toc-all" data-i18n-tip="ui.toc.all_tip">±</button>
  </div>
  <ul class="toc-list" id="toc-ch"></ul>
  <ul class="toc-list" id="toc-as" hidden></ul>
</aside>

<main id="top">
  <p class="source-line">
    {%- for name, st in source_status.items() %}
    {%- set date = st.snapshot_date or '—' %}
    <span class="badge badge-{{ st.freshness or 'missing' }}"
          {%- if st.error %} data-tip="{{ st.error | e }}"
          {%- else %} data-i18n-tip="ui.data_asof" data-i18n-args='{{ {"date": date} | tojson }}'{% endif %}>{{ name }} · {{ date }}</span>
    {%- endfor %}
  </p>

  <section class="section" id="sec-brief">
    <h2 class="section-title"><span class="section-index">00</span><span
        data-i18n="sec.brief.title">{{ t('sec.brief.title') | e }}</span>
      <span class="section-sub" data-i18n="sec.brief.sub">{{ t('sec.brief.sub') | e }}</span>
      <span class="collapsed-mark" data-i18n="ui.collapsed">{{ t('ui.collapsed') | e }}</span></h2>
    <div class="section-body">
      <div class="grid2">
        {% include 'panels/digest.j2' %}
        {% include 'panels/radar.j2' %}
      </div>
    </div>
  </section>

  <section class="section" id="sec-arr">
    <h2 class="section-title"><span class="section-index">01</span><span>Frontier Lab ARR</span>
      <span class="section-sub" data-i18n="sec.arr.sub">{{ t('sec.arr.sub') | e }}</span>
      <span class="collapsed-mark" data-i18n="ui.collapsed">{{ t('ui.collapsed') | e }}</span></h2>
    <div class="section-body">
      {% include 'panels/arr_cards.j2' %}
      {% include 'panels/arr_chart.j2' %}
      {% include 'panels/arr_anchors.j2' %}
    </div>
  </section>

  <section class="section" id="sec-tokens">
    <h2 class="section-title"><span class="section-index">02</span><span
        data-i18n="sec.tokens.title">{{ t('sec.tokens.title') | e }}</span>
      <span class="section-sub">OpenRouter · Vercel Gateway · SDK</span>
      <span class="collapsed-mark" data-i18n="ui.collapsed">{{ t('ui.collapsed') | e }}</span></h2>
    <div class="section-body">
      <div class="grid2">
        {% include 'panels/or_tracked.j2' %}
        {% include 'panels/or_top.j2' %}
        {% include 'panels/or_weekly_total.j2' %}
        {% include 'panels/vercel_trend.j2' %}
        {% include 'panels/vercel_share.j2' %}
        {% include 'panels/sdk.j2' %}
      </div>
      {% include 'panels/quotes.j2' %}
    </div>
  </section>

  <section class="section" id="sec-gpu">
    <h2 class="section-title"><span class="section-index">03</span><span
        data-i18n="sec.gpu.title">{{ t('sec.gpu.title') | e }}</span>
      <span class="section-sub" data-i18n="sec.gpu.sub">{{ t('sec.gpu.sub') | e }}</span>
      <span class="collapsed-mark" data-i18n="ui.collapsed">{{ t('ui.collapsed') | e }}</span></h2>
    <div class="section-body">
      {% include 'panels/gpu_table.j2' %}
      {% include 'panels/gpu_trend.j2' %}
    </div>
  </section>

  <section class="section" id="sec-dc">
    <h2 class="section-title"><span class="section-index">04</span><span
        data-i18n="sec.dc.title">{{ t('sec.dc.title') | e }}</span>
      <span class="section-sub">Epoch AI + News</span>
      <span class="collapsed-mark" data-i18n="ui.collapsed">{{ t('ui.collapsed') | e }}</span></h2>
    <div class="section-body">
      {% include 'panels/dc_cards.j2' %}
      {% include 'panels/dc_growth.j2' %}
      {% include 'panels/epoch_sites.j2' %}
      {% include 'panels/news.j2' %}
    </div>
  </section>

  {% include 'panels/methodology.j2' %}
</main>

<footer class="footer">
  <p data-i18n="ui.footer">{{ t('ui.footer') | e }}</p>
</footer>

<div id="tip" hidden></div>

<script id="dashboard-data" type="application/json">{{ dashboard_json }}</script>
<script id="i18n-data" type="application/json">{{ i18n_json }}</script>
<script id="terms-data" type="application/json">{{ terms_json }}</script>
<script>
{{ chart_js }}
</script>
<script>
{{ app_js }}
</script>
</body>
</html>
