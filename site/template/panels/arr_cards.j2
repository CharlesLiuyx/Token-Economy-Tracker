{% from '_macros.j2' import badge with context %}
{# 曲线形态 -> i18n key；新增候选形态时这里必须同步补一项（否则 build 直接报错） #}
{% set model_keys = {
     'linear': 'panel.arr.model.linear',
     'exponential': 'panel.arr.model.exponential',
     'log_quadratic': 'panel.arr.model.log_quadratic',
   } %}
{# 最近披露距今 -> 估算可信度：≤45 天〔中〕，更久〔低〕（纯外推） #}
{% set conf_keys = {'ok': 'ui.conf.mid', 'warn': 'ui.conf.low', 'stale': 'ui.conf.low'} %}
<div class="grid2 arr-grid">
{% for c in arr_cards %}
  <section class="panel arr-card company-{{ c.company }}" id="p-arr-{{ c.company }}">
    <header class="panel-head">
      <h3 data-i18n="panel.arr.card_title" data-i18n-args='{{ {"name": c.display} | tojson }}'>{{ t('panel.arr.card_title', name=c.display) | e }}</h3>
      <span class="est-badge" data-i18n-tip="panel.arr.est_title"
            data-i18n="panel.arr.est_badge">{{ t('panel.arr.est_badge') | e }}</span>
      <span class="conf" data-i18n-tip="panel.arr.conf_tip"
            data-i18n="{{ conf_keys[c.age_class] }}">{{ t(conf_keys[c.age_class]) | e }}</span>
      {{ badge('arr') }}
    </header>
    <div class="panel-body">
      <p class="arr-number" data-arr="{{ c.arr_at_build }}" data-rate="{{ c.usd_per_hour }}">${{ '{:,}'.format(c.arr_at_build) }}</p>
      <p class="arr-sub">
        <span class="chip age-{{ c.age_class }}" data-i18n-tip="panel.arr.age_tip"
              data-i18n="panel.arr.age" data-i18n-args='{{ {"days": c.anchor_age_days} | tojson }}'>{{ t('panel.arr.age', days=c.anchor_age_days) | e }}</span>
        <span class="chip"><span data-i18n="panel.arr.last_disclosed">{{ t('panel.arr.last_disclosed') | e }}</span> {{ c.last_anchor_date }} · ${{ '%.0f' | format(c.last_anchor_value / 1e9) }}B</span>
        <span class="chip" data-i18n-tip="panel.arr.multiple_tip">×{{ '%.2f' | format(c.multiple) }}</span>
        <span class="chip">implied MoM {{ '%+.1f' | format(c.mom * 100) }}%</span>
        <span class="chip">+${{ '{:,}'.format(c.usd_per_hour) }}/hr</span>
        {% set mk = model_keys[c.model] %}
        <span class="chip" data-i18n-tip="panel.arr.model_title"
              data-i18n="{{ mk }}">{{ t(mk) | e }}</span>
      </p>
      <p class="arr-range"><span data-i18n="panel.arr.range">{{ t('panel.arr.range') | e }}</span>
        ${{ '%.0f' | format(c.lo / 1e9) }}B – ${{ '%.0f' | format(c.hi / 1e9) }}B
        · n={{ c.n_anchors }}</p>
    </div>
  </section>
{% endfor %}
</div>
