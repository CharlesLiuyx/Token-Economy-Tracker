{% from '_macros.j2' import panel with context %}
{% call panel('epoch_sites', 'panel.epoch_sites.title', 'epoch_datacenters', kind='tbl', flush=True) %}
    <table class="data-table">
      <thead><tr><th class="num">#</th><th data-sort="text">Site</th><th data-sort="text">Owner</th><th>Users</th>
                 <th data-sort="text">Country</th>
                 <th class="num" data-sort="num">MW</th><th class="num" data-sort="num">k H100-eq</th>
                 <th class="num" data-sort="num">Capex $B</th></tr></thead>
      <tbody>
      {% for s in epoch_sites %}
        <tr>
          <td class="num flat">{{ loop.index }}</td>
          <td class="strong" data-v="{{ s.name | e }}">{{ s.name | e }}</td><td data-v="{{ s.owner | e }}">{{ s.owner | e }}</td><td>{{ s.users | e }}</td>
          <td data-v="{{ s.country | e }}">{{ s.country | e }}</td>
          <td class="num cell-bar" data-v="{{ s.power_mw }}"><b style="width:{{ '%.0f' | format(s.power_pct) }}%"></b><span>{{ '{:,}'.format(s.power_mw) }}</span></td>
          <td class="num" data-v="{{ s.h100_k }}">{{ '{:,}'.format(s.h100_k) }}</td>
          <td class="num" data-v="{{ s.capex_b }}">{{ '%.1f' | format(s.capex_b) }}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
{% endcall %}
